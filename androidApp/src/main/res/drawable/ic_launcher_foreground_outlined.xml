<?xml version="1.0" encoding="utf-8"?>
<!--
    The summit in white with a dark outline, standing inside the icon, so it stands out over a patterned background:
    the one-color shapes (ic_launcher_monochrome.xml) with the body cut off at y 82, lifted 4 to sit centred.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateY="-4">
        <group>
            <clip-path android:pathData="@string/launcher_summit_sun_clip" />
            <!-- Stroke first, fill over it: only the outer half of the outline shows, as on the mountain. -->
            <path
                android:strokeColor="@color/launcher_mark_outline"
                android:strokeWidth="5"
                android:pathData="@string/launcher_summit_sun" />
            <path android:fillColor="#FFFFFF" android:pathData="@string/launcher_summit_sun" />
        </group>
        <path
            android:strokeColor="@color/launcher_mark_outline"
            android:strokeWidth="5"
            android:strokeLineJoin="round"
            android:pathData="@string/launcher_summit_cap" />
        <path
            android:strokeColor="@color/launcher_mark_outline"
            android:strokeWidth="5"
            android:strokeLineJoin="round"
            android:pathData="@string/launcher_summit_badge_body" />
        <path android:fillColor="#FFFFFF" android:pathData="@string/launcher_summit_cap" />
        <path android:fillColor="#FFFFFF" android:pathData="@string/launcher_summit_badge_body" />
    </group>
</vector>
